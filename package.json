{
  "name": "dsh-mc-instances",
  "version": "1.0.4",
  "description": "Minecraft mod-testing instance manager for DeepSeek Harness: a PCL2-style right-sidebar panel that detects run/<name>/ profiles, launches/stops them, toggles mods, tails game and Gradle logs, creates/deletes instances and writes IntelliJ run configurations.",
  "type": "module",
  "license": "MIT",
  "author": "XIN (https://github.com/xin070710)",
  "homepage": "https://github.com/xin070710/dsh-mc-instances#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xin070710/dsh-mc-instances.git"
  },
  "bugs": {
    "url": "https://github.com/xin070710/dsh-mc-instances/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "minecraft",
    "modding",
    "mod-testing",
    "fabric",
    "neoforge",
    "forge",
    "gradle",
    "intellij",
    "pcl2",
    "instance-manager"
  ],
  "main": "src/index.js",
  "icon": "assets/icon-180.png",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./profiles": {
      "default": "./src/profiles.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "assets",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1"
  },
  "scripts": {
    "test": "node --test",
    "pack:dry": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
